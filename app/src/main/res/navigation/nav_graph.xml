<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/dashboardFragment">

    <activity
        android:id="@+id/mainActivity"
        android:name="com.mariofronza.agis.ui.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
    <activity
        android:id="@+id/signInActivity"
        android:name="com.mariofronza.agis.ui.auth.SignInActivity"
        android:label="activity_sign_in"
        tools:layout="@layout/activity_sign_in" />
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.mariofronza.agis.ui.dashboard.DashboardFragment"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard" />
    <fragment
        android:id="@+id/awaitFragment"
        android:name="com.mariofronza.agis.ui.retrieve.RetrieveActivity"
        android:label="fragment_await"
        tools:layout="@layout/activity_await" />
    <activity
        android:id="@+id/signUpActivity"
        android:name="com.mariofronza.agis.ui.auth.SignUpActivity"
        android:label="activity_sign_up"
        tools:layout="@layout/activity_sign_up" />
</navigation>